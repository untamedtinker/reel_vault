{
  "manifest_version": 3,
  "name": "Reel Vault",
  "version": "2.1",
  "description": "Extracts complete reel metadata including authors, timestamps, and captions into clean JSON.",
  "permissions": [
    "scripting",
    "downloads",
    "windows",
    "tabs",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://www.instagram.com/*"
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "action": {
    "default_popup": "pages/popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "index.html",
        "pages/*",
        "css/*",
        "js/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}